<UserControl x:Class="GpCrawler2.Pages.About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mui="http://firstfloorsoftware.com/ModernUI"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    
    <Grid x:Name="AboutGrid" Style="{StaticResource ContentRoot}">
        <ScrollViewer>
            <StackPanel MinWidth="200">
                <TextBlock Text="COPYRIGHT" Style="{StaticResource Heading2}" />
                <TextBlock Text="Copyright 2013 by Tino Bickel." />
                <TextBlock Margin="0,30,0,0">
                    <Run Text="Number of Songs: " FontWeight="Bold"/>
                    <Run Text="{Binding NumberOfSongs}"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
