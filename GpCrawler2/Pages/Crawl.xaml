<UserControl x:Class="GpCrawler2.Pages.Crawl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mui="http://firstfloorsoftware.com/ModernUI"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
    
    
    <Grid x:Name="CrawlGrid" Style="{StaticResource ContentRoot}"  Margin="10,0,0,10">
        <DockPanel Margin="0,10,0,0" LastChildFill="False">
            <DockPanel Height="25" Margin="0,0,0,15" DockPanel.Dock="Top">
                <TextBlock Text="Daten-Verzeichnis" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button x:Name="SelectDataDirButton" Content="..." DockPanel.Dock="Right" Width="20"/>
                <TextBox x:Name="DataDirTextBox" Text="{Binding DataDir}" Margin="10,0,10,0"/>
            </DockPanel>

            <Button x:Name="StartCrawlButton" 
                    Content="Starte Crawler" 
                    Click="StartCrawlButton_Click" 
                    DockPanel.Dock="Top"
                    Width="180"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Left"/>

            <Button x:Name="ClearDatabaseButton" 
                    Content="Databank leeren!" 
                    Click="ClearDatabaseButton_Click" 
                    DockPanel.Dock="Top"
                    Width="180"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                <ProgressBar x:Name="Progress" Width="180" Height="24"/>
                <TextBlock x:Name="InfoTextBlock" Margin="10,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
    
</UserControl>
