<UserControl x:Class="GpCrawler2.Pages.Player"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mui="http://firstfloorsoftware.com/ModernUI" 
             xmlns:local="clr-namespace:GpCrawler2.Controls"
             xmlns:svl="clr-namespace:WPFSoundVisualizationLib;assembly=WPFSoundVisualizationLib"
             mc:Ignorable="d" 
             d:DesignHeight="300" 
             d:DesignWidth="600"
             x:Name="PlayerControl"
             >

    <Grid x:Name="PlayerGrid" Style="{StaticResource ContentRoot}">
       
        <Grid>
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="Auto" />-->
                <RowDefinition Height="150" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Display Controls -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <svl:DigitalClock x:Name="clockDisplay"
                                  Grid.Column="0"
                                  ShowHours="False"
                                  ShowSubSeconds="True"
                                  HorizontalAlignment="Center"
                                  Margin="5" />

                <svl:SpectrumAnalyzer x:Name="spectrumAnalyzer"
                                      Margin="5"
                                      BarCount="16" 
                                      Grid.Column="1"/>

                <svl:Equalizer NumberOfBands="16" Grid.Column="2"/>

            </Grid>

            <!-- WaveForm -->
            <svl:WaveformTimeline x:Name="waveformTimeline"
                                  Margin="5"
                                  BorderThickness="1" 
                                  Grid.Row="1"/>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Grid.Row="2">

                <DockPanel HorizontalAlignment="Right" Grid.Column="1">

                   

                    <Button Name="PlayButton"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Width="50"
                            Height="24"
                            Margin="10,2,2,2"
                            Click="PlayButton_Click"
                            IsEnabled="False"
                            Content="Play" />
                    
                    <Button Name="PauseButton"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Width="50"
                            Height="24"
                            Margin="2"
                            Click="PauseButton_Click"
                            IsEnabled="False"
                            Content="Pause" />
                    
                    <Button Name="StopButton"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Width="50"
                            Height="24"
                            Margin="2"
                            Click="StopButton_Click"
                            IsEnabled="False"
                            Content="Stop" />

                    <Button Content="Browse"
                            DockPanel.Dock="Left"
                            Height="24"
                            Width="50"
                            Margin="2"
                            Name="BrowseButton"
                            VerticalAlignment="Center"
                            Click="BrowseButton_Click" />

                    <TextBox VerticalAlignment="Center"
                         HorizontalAlignment="Stretch"
                         Margin="5"
                         Height="25"
                         IsReadOnly="True"
                         Name="FileText" />

                </DockPanel>
            </StackPanel>

            <DockPanel Grid.Row="3">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <svl:TimeEditor Margin="5"
                                    Name="repeatStartTimeEdit"
                                    IsReadOnly="False"/>

                    <svl:TimeEditor Margin="5"
                                    Name="repeatStopTimeEdit"
                                    IsReadOnly="False" />
                </StackPanel>

                <Button Name="CreateTimesnapshotButton"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Width="50"
                            Height="24"
                            Margin="2"
                            Click="CreateTimesnapshotButton_Click"
                            Content="Save" />
                
                <local:TimeSectionLister x:Name="TimeSectionLister1" Margin="10,0,0,0"/>
            </DockPanel>
            
            <svl:AlbumArtDisplay x:Name="albumArtPanel" Margin="5" Grid.Column="1" Visibility="Collapsed"/>
        </Grid>
        
    </Grid>
</UserControl>