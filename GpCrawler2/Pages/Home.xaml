<UserControl x:Class="GpCrawler2.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mui="http://firstfloorsoftware.com/ModernUI"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DesignHeight="300" d:DesignWidth="300">

    <Grid x:Name="HomeGrid" Style="{StaticResource ContentRoot}"  Margin="10,0,0,10">
        <DockPanel Margin="0,10,0,0">

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" >
                <TextBox x:Name="SongFilterTextBox"
                         Width="250" 
                         Height="24" 
                         Text="{Binding Path=FilterText, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Left"/>
                
                <Image Source="/Resources/Icons/Favorite.png" Width="16" Height="16" Margin="30,0,0,0"/>
            </StackPanel>

            <DataGrid x:Name="SongDataGrid"
                      ItemsSource="{Binding ExistingSongsView}"  
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single" 
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Song" Width="*" Binding="{Binding Path=SongName}" />
                    <DataGridTextColumn Header="Band" Width="*" Binding="{Binding Path=BandName}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
